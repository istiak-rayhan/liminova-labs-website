# Public site URL used for canonical, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://liminovalabs.io

# Optional conversion paths. Leave empty to hide or use the email fallback.
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=8801355412144
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FIVERR_URL=
NEXT_PUBLIC_UPWORK_URL=

# Nodemailer (Gmail app password or SMTP user). Required for /api/contact.
EMAIL_USER=
EMAIL_PASS=

# Admin dashboard (single-operator login). Never commit real secrets.
ADMIN_EMAIL=liminovalabs@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob (auto-provisioned on Vercel). Used to persist CMS projects/team.
BLOB_READ_WRITE_TOKEN=
